--- AVAILABLE ACTIONS ---
{% if racer.status == "racing" %}
- control(race_id="{{ race_id }}", player_id="{{ player_id }}", target_speed=N) - Set speed 0-{{ racer.max_speed }}
{% if racer.in_drift_zone and not racer.drift_enabled %}
- control(race_id="{{ race_id }}", player_id="{{ player_id }}", drift=True) - Enable drift for upcoming turn
{% endif %}
{% if racer.power_up %}
- control(race_id="{{ race_id }}", player_id="{{ player_id }}", use_item=True) - Use your {{ racer.power_up }}
{% endif %}
{% else %}
No actions available - {{ "race finished" if racer.status == "finished" else "waiting for penalty to clear" }}
{% endif %}

--- TIPS ---
{% set next_turn_distance = namespace(value=None) %}
{% for tile in upcoming_tiles %}
{% if tile.type == "turn_left" and next_turn_distance.value is none %}
{% set next_turn_distance.value = tile.distance_tiles %}
{% endif %}
{% endfor %}
{% if next_turn_distance.value is not none %}
Next turn in {{ next_turn_distance.value }} tile{% if next_turn_distance.value > 1 %}s{% endif %}.
{% if next_turn_distance.value <= 2 %}
{% if racer.speed > 1 and not racer.drift_enabled and not racer.in_drift_zone %}
WARNING: Slow to speed 1 NOW or you will crash!
{% elif racer.in_drift_zone and not racer.drift_enabled %}
TIP: Enable drift now to maintain speed 2 through the turn, or brake to speed 1.
{% endif %}
{% elif next_turn_distance.value <= 4 %}
TIP: Prepare for the turn. Drift zone starts 3 tiles before the turn.
{% endif %}
{% else %}
Clear straightaway ahead - full speed recommended!
{% endif %}
