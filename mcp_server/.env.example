# MCP Server Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# GitHub OAuth
# ===========================================
# Create a GitHub OAuth App at: https://github.com/settings/developers
# - Homepage URL: Your ngrok URL (for local dev) or production URL
# - Authorization callback URL: {MCP_BASE_URL}/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===========================================
# MCP Server URLs
# ===========================================
# Public URL where MCP server is accessible (use ngrok for local dev)
MCP_BASE_URL=http://localhost:8080

# Backend API URL (internal, doesn't need to be public)
MCPKART_BACKEND_URL=http://localhost:8000

# ===========================================
# Security Keys
# ===========================================
# JWT signing key for FastMCP tokens
# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=

# Fernet encryption key for OAuth token storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# ===========================================
# Redis (for OAuth token storage)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
