# MCP Server Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# GitHub OAuth
# ===========================================
# Create a GitHub OAuth App at: https://github.com/settings/developers
# - Homepage URL: Your ngrok URL (for local dev) or production URL
# - Authorization callback URL: {MCP_BASE_URL}/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===========================================
# MCP Server URLs
# ===========================================
# Public URL where MCP server is accessible (use ngrok for local dev)
MCP_BASE_URL=http://localhost:8080

# Backend API URL (use Docker service name)
MCPKART_BACKEND_URL=http://backend:8000

# ===========================================
# Security Keys
# ===========================================
# JWT signing key for FastMCP tokens
# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=

# Fernet encryption key for OAuth token storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# ===========================================
# Redis (for OAuth token storage)
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================
# NPC Bot Authentication
# ===========================================
# Static tokens for NPC (bot) racers
# Format: "username1:secret1,username2:secret2,..."
#
# Generate secure secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Example: NPC_TOKENS="bot-racer-1:abc123xyz789,bot-racer-2:def456uvw123"
#
# Leave empty to disable NPC authentication
NPC_TOKENS=
