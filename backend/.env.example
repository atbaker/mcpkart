# Backend Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Sync driver (for Alembic migrations)
DATABASE_URL=postgresql+psycopg://mcpkart:mcpkart_dev@postgres:5432/mcpkart
# Async driver (for FastAPI and Temporal activities)
ASYNC_DATABASE_URL=postgresql+asyncpg://mcpkart:mcpkart_dev@postgres:5432/mcpkart

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://redis:6379

# ===========================================
# Temporal
# ===========================================
TEMPORAL_HOST=temporal:7233

# ===========================================
# Race Configuration
# ===========================================
# Max racers per race (humans + NPCs). Default is 8 for prod, use 4 for dev.
MAX_RACERS=4

# ===========================================
# NPC Bot Spawning
# ===========================================
# URL where MCP server is accessible (for NPC vibe processes)
MCP_SERVER_URL=http://localhost:8080

# Mistral API key for Vibe CLI (passed to NPC containers)
MISTRAL_API_KEY=
